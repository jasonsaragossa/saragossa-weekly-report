{
  "auth": {
    "identityProviders": {
      "azureActiveDirectory": {
        "userDetailsClaim": "http://schemas.xmlsoap.org/ws/2005/05/identity/claims/emailaddress",
        "registration": {
          "openIdIssuer": "https://login.microsoftonline.com/d309a9f4-2d5e-4d65-9ea9-6950cec1a1fe/v2.0",
          "clientIdSettingName": "AZURE_CLIENT_ID",
          "clientSecretSettingName": "AZURE_CLIENT_SECRET"
        },
        "login": {
          "loginParameters": ["domain_hint=saragossa.io"]
        }
      }
    }
  },
  "routes": [
    {
      "route": "/settings",
      "allowedRoles": ["authenticated"]
    },
    {
      "comment": "Called by the Logic App scheduler — no user identity, guarded by x-api-key in the function itself",
      "route": "/api/board-schedule-run",
      "allowedRoles": ["anonymous"]
    },
    {
      "comment": "Monthly SharePoint pull, same scheduler and same x-api-key guard",
      "route": "/api/commission-sync-run",
      "allowedRoles": ["anonymous"]
    },
    {
      "comment": "Read by the promotion tracker — guarded by PROMOTION_TRACKER_KEY, or an admin session",
      "route": "/api/promotion-data",
      "allowedRoles": ["anonymous"]
    },
    {
      "comment": "Wall screen shown through OneUp, which cannot sign in — the page carries a key in its URL and the API checks it against SCREEN_KEY. Framing is allowed so OneUp can embed it.",
      "route": "/contract-screen",
      "allowedRoles": ["anonymous"],
      "headers": {
        "X-Frame-Options": "ALLOWALL",
        "Content-Security-Policy": "frame-ancestors *",
        "Cache-Control": "no-cache"
      }
    },
    {
      "route": "/contract-screen.html",
      "allowedRoles": ["anonymous"],
      "headers": {
        "X-Frame-Options": "ALLOWALL",
        "Content-Security-Policy": "frame-ancestors *",
        "Cache-Control": "no-cache"
      }
    },
    {
      "route": "/contract-screen.js",
      "allowedRoles": ["anonymous"]
    },
    {
      "route": "/api/contract-screen",
      "allowedRoles": ["anonymous"]
    },
    {
      "comment": "Brand assets the wall screen needs before anyone has signed in",
      "route": "/logo.svg",
      "allowedRoles": ["anonymous"]
    },
    {
      "route": "/favicon.svg",
      "allowedRoles": ["anonymous"]
    },
    {
      "route": "/fonts/*",
      "allowedRoles": ["anonymous"]
    },
    {
      "route": "/api/*",
      "allowedRoles": ["authenticated"]
    },
    {
      "route": "/*",
      "allowedRoles": ["authenticated"]
    }
  ],
  "responseOverrides": {
    "401": {
      "redirect": "/.auth/login/aad",
      "statusCode": 302
    },
    "403": {
      "rewrite": "/403.html",
      "statusCode": 403
    }
  },
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/assets/*", "*.{css,js,png,ico,svg,json}"]
  }
}
